#!/bin/bash -l
# ESMFold patching on one L40S. Submit from the repo root; arguments after the
# file name go straight to scripts/patch_esmfold.py:
#
#   qsub scripts/patch_esmfold.qsub full
#   qsub scripts/patch_esmfold.qsub full --limit 20
#   qsub scripts/patch_esmfold.qsub single --model /path/to/weights/esmfold
#   qsub scripts/patch_esmfold.qsub full --venv /path/to/venv
#
# --venv activates that virtualenv first; it is not passed on to the Python script.
# Rerunning a stage resumes from its CSV, so resubmit if the time limit cuts it off.

# Pass the project with -P on the qsub command line: qsub -P <project> scripts/patch_esmfold.qsub ...
#$ -N patch_esmfold
#$ -l gpus=1
#$ -l gpu_type=L40S
#$ -pe omp 8
#$ -l h_rt=48:00:00
#$ -cwd
#$ -j y

venv=""
args=()
while [ $# -gt 0 ]; do
    case "$1" in
        --venv) venv="$2"; shift 2 ;;
        --venv=*) venv="${1#--venv=}"; shift ;;
        *) args+=("$1"); shift ;;
    esac
done

if [ ${#args[@]} -eq 0 ]; then
    echo "usage: qsub scripts/patch_esmfold.qsub {full|single|summary} [--limit N] [--model DIR] [--venv DIR]" >&2
    exit 1
fi

# mkdssp comes from the cluster module. Loaded before the venv so the venv's python stays first on the PATH.
module load dssp

# Triton compiles a C helper on first use and needs Python.h, which the system python the venv is built on lacks.
# The module python has the headers; they must be for the same minor version as the venv.
module load python3/3.12.4 || exit 1
header_version="$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')"
export C_INCLUDE_PATH="$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["include"])')${C_INCLUDE_PATH:+:$C_INCLUDE_PATH}"

# The environment needs the packages from requirements.txt.
if [ -n "$venv" ]; then
    source "$venv/bin/activate" || exit 1
fi

# Headers from another Python version compile, then fail at run time inside Triton.
python_version="$(python -c 'import sys; print("%d.%d" % sys.version_info[:2])')"
if [ "$header_version" != "$python_version" ]; then
    echo "Python headers are for $header_version but the job runs Python $python_version; fix the python3 module above." >&2
    exit 1
fi

nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
python scripts/patch_esmfold.py "${args[@]}"
